# ---------------------------------------------------------------------------
# TubeForge configuration. Copy to `.env` — every value below is optional.
# ---------------------------------------------------------------------------

# HTTP port for the Express server.
PORT=3000

# Media engine: auto | ytdl | ytdlp
#   auto  -> try @distube/ytdl-core first, transparently fall back to yt-dlp
#   ytdl  -> force the @distube/ytdl-core library
#   ytdlp -> force the yt-dlp binary (must be on PATH or set YTDLP_PATH)
MEDIA_ENGINE=auto

# Explicit binary paths (auto-detected when omitted).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Path to a Netscape/JSON cookie export. Lets the engines reach age-restricted
# or rate-limited videos. JSON is consumed by ytdl-core, txt by yt-dlp.
# COOKIES_FILE=./cookies.json

# Optional: enables Claude-generated study material. Without a key the app
# falls back to the built-in offline analyser (no network, still functional).
# ANTHROPIC_API_KEY=sk-ant-...
# STUDY_MODEL=claude-opus-5

# Housekeeping
CLIP_RETENTION_HOURS=24
MAX_CLIP_SECONDS=600
CACHE_TTL_MINUTES=60

# Ceiling for a download conversion that needs a real re-encode (e.g. MP4 to
# WebM). Remuxes ignore this because they are cheap. Longer sources should be
# trimmed in the Clip Studio instead of tying the box up for an hour.
MAX_TRANSCODE_SECONDS=900

# Animated GIFs are roughly one image per frame, so they get a tighter cap.
MAX_GIF_SECONDS=30

# Largest playlist the Playlist view will list.
# MAX_PLAYLIST_ITEMS=400

# ---------------------------------------------------------------------------
# Study Mode — local speech-to-text fallback
# ---------------------------------------------------------------------------
# When media has no caption track, Study Mode transcribes the audio on this
# machine with whisper.cpp. `npm run setup:whisper` builds bin/whisper-cli and
# downloads models/ggml-base.bin plus the Silero voice-activity model that
# stops music and silence from being "transcribed" into invented words.
# WHISPER_MODEL=small npm run setup:whisper  -> better Azerbaijani/Turkish.
#
# Overrides (auto-detected from bin/ and models/ when omitted):
# WHISPER_BIN=/usr/local/bin/whisper-cli
# WHISPER_MODEL_FILE=./models/ggml-small.bin
# WHISPER_VAD_MODEL=./models/ggml-silero-v5.1.2.bin
#
# Only the first N seconds of long media are transcribed.
MAX_SPEECH_SECONDS=1800

# ---------------------------------------------------------------------------
# Audio ID — song recognition
# ---------------------------------------------------------------------------
# Works out of the box on AudD's free keyless tier (a small daily quota).
# A token from https://dashboard.audd.io raises the limit.
# AUDD_API_TOKEN=
#
# Optional ACRCloud project (https://console.acrcloud.com). When all three are
# set, ACRCloud is tried first and AudD becomes the fallback.
# ACR_HOST=identify-eu-west-1.acrcloud.com
# ACR_ACCESS_KEY=
# ACR_ACCESS_SECRET=
#
# Note: browsers only allow microphone/system-audio capture on HTTPS or on
# localhost. Serve TubeForge behind HTTPS when using it from another device.
